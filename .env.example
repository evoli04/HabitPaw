# Env for the root prototype scripts (petStatusMotor.js, test.js, testgemini.js).
# These scripts load ".env" first and fall back to "backend/.env", so anything already
# set in backend/.env (GEMINI_API_KEY, GEMINI_MODEL, SUPABASE_URL) can be left out here.

# Only needed if you want to override backend/.env
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-3.5-flash"

# Supabase login used by petStatusMotor.js. Without these the script runs the AI part
# on sample data and skips the database step.
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_ANON_KEY="your-supabase-publishable-key"
USER_EMAIL="dev-user@example.com"
USER_PASSWORD="dev-user-password"
