generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HabitFrequency {
  daily
  weekdays
  weekends
}

model Profile {
  id        String   @id @db.Uuid
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  habits            Habit[]
  habitCompletions  HabitCompletion[]
  cats              Cat[]
  aiRecommendations AiRecommendation[]

  @@map("profiles")
}

model Habit {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  title        String         @db.VarChar(100)
  description  String?        @db.VarChar(500)
  frequency    HabitFrequency @default(daily)
  reminderTime DateTime?      @map("reminder_time") @db.Time()
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")

  user        Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

model HabitCompletion {
  id             String   @id @default(uuid()) @db.Uuid
  habitId        String   @map("habit_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  completionDate DateTime @map("completion_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  habit Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, completionDate])
  @@index([userId, completionDate])
  @@map("habit_completions")
}

model Cat {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  name      String   @default("Paw")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cats")
}

model AiRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  goal           String?  @db.VarChar(300)
  requestContext Json     @map("request_context")
  suggestions    Json
  model          String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_recommendations")
}